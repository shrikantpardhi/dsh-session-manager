# Normalize line endings so a clone on any platform matches CI.
* text=auto eol=lf

# Windows-only scripts keep CRLF if any are ever added.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets must never be converted.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.tgz binary
